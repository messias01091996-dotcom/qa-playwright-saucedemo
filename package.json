{
  "name": "qa-playwright-saucedemo",
  "version": "1.0.0",
  "private": true,
  "description": "Cinco cenários E2E com Playwright e TypeScript no SauceDemo",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --project=chromium --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:all": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:list": "playwright test --project=chromium --list",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
